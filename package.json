{
  "name": "huaji-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 5173 --strictPort",
    "dev:ui": "vp dev --config vite.config.ui.ts",
    "dev:development": "CLOUDFLARE_ENV=development vp dev",
    "build": "vp build",
    "build:ui": "vp build --config vite.config.ui.ts",
    "build:development": "CLOUDFLARE_ENV=development vp build",
    "deploy": "vp build && wrangler deploy",
    "deploy:development": "CLOUDFLARE_ENV=development npm run deploy",
    "deploy:dry-run": "vp build && wrangler deploy --dry-run",
    "deploy:development:dry-run": "CLOUDFLARE_ENV=development npm run deploy:dry-run",
    "contracts:generate": "node scripts/generate-contract-schemas.ts && vp fmt contracts/v1/ingress.schema.json contracts/v1/reply-job.schema.json",
    "types": "wrangler types",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test run",
    "check": "npm run types && vp check && vp test run && vp build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@flue/react": "^2.1.1",
    "@flue/runtime": "^2.1.1",
    "@flue/sdk": "^2.1.1",
    "hono": "^4.13.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "valibot": "^1.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@flue/cli": "^2.1.1",
    "@flue/vite": "^2.1.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1",
    "vite-plus": "1.0.0-rc.1",
    "wrangler": "^4.141.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
