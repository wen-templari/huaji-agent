{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "huaji-agent",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "HUAJIBOT_REPLY_TRANSPORT": "queue",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUAJIBOT_REPLY_CAPTURES",
        "class_name": "HuajiBotReplyCapture",
      },
    ],
  },
  "queues": {
    "producers": [
      {
        "binding": "HUAJIBOT_OUTBOUND",
        "queue": "huajibot-outbound-main",
      },
    ],
  },
  "secrets": {
    "required": [
      "HUAJI_MODEL_BASE_URL",
      "HUAJI_MODEL_API_KEY",
      "HUAJI_MODEL_ID",
      "HUAJI_MODEL_API",
      "HUAJI_MODEL_CONTEXT_WINDOW",
      "HUAJI_MODEL_MAX_OUTPUT_TOKENS",
      "HUAJIBOT_SIGNING_SECRET",
      "HUAJIBOT_ALLOWED_DESTINATIONS",
    ],
  },
  "migrations": [
    {
      "tag": "flue-class-FlueHuajiAgent",
      "new_sqlite_classes": ["FlueHuajiAgent"],
    },
    {
      "tag": "huajibot-development-reply-capture",
      "new_sqlite_classes": ["HuajiBotReplyCapture"],
    },
  ],
  "env": {
    "development": {
      "name": "huaji-agent-development",
      "vars": {
        "HUAJIBOT_REPLY_TRANSPORT": "capture",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "HUAJIBOT_REPLY_CAPTURES",
            "class_name": "HuajiBotReplyCapture",
          },
        ],
      },
      "secrets": {
        "required": [
          "HUAJI_MODEL_BASE_URL",
          "HUAJI_MODEL_API_KEY",
          "HUAJI_MODEL_ID",
          "HUAJI_MODEL_API",
          "HUAJI_MODEL_CONTEXT_WINDOW",
          "HUAJI_MODEL_MAX_OUTPUT_TOKENS",
          "HUAJIBOT_SIGNING_SECRET",
          "HUAJIBOT_ALLOWED_DESTINATIONS",
        ],
      },
      "queues": {
        "producers": [
          {
            "binding": "HUAJIBOT_OUTBOUND",
            "queue": "huajibot-outbound-main-development",
          },
        ],
      },
    },
  },
}
