{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbtca/huaji-agent/contracts/v1/reply-job.schema.json",
  "title": "HuaJiBot reply job v1",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "maxLength": 64,
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^huajibot:"
    },
    "destination": {
      "type": "object",
      "properties": {
        "bridgeInstance": {
          "$ref": "#/$defs/__schema0"
        },
        "robotId": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema0"
            },
            {
              "type": "null"
            }
          ]
        },
        "groupId": {
          "$ref": "#/$defs/__schema0"
        },
        "replyToMessageId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["bridgeInstance", "robotId", "groupId", "replyToMessageId"],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "markdown"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "required": ["format", "text"],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": ["version", "jobId", "conversationId", "destination", "content", "createdAt"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
