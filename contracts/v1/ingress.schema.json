{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nbtca/huaji-agent/contracts/v1/ingress.schema.json",
  "title": "HuaJiBot ingress event v1",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "eventId": {
      "$ref": "#/$defs/__schema0"
    },
    "conversationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^huajibot:"
    },
    "destination": {
      "type": "object",
      "properties": {
        "bridgeInstance": {
          "$ref": "#/$defs/__schema0"
        },
        "robotId": {
          "$ref": "#/$defs/__schema1"
        },
        "groupId": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": ["bridgeInstance", "robotId", "groupId"],
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "properties": {
        "messageId": {
          "$ref": "#/$defs/__schema0"
        },
        "senderId": {
          "$ref": "#/$defs/__schema0"
        },
        "senderName": {
          "type": "string",
          "maxLength": 512
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": ["messageId", "senderId", "senderName", "text"],
      "additionalProperties": false
    },
    "replyTo": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "messageId": {
              "$ref": "#/$defs/__schema1"
            },
            "senderId": {
              "$ref": "#/$defs/__schema1"
            },
            "content": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 8192
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["messageId", "senderId", "content"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "occurredAt": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": ["version", "eventId", "conversationId", "destination", "message", "occurredAt"],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "__schema1": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
